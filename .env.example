# Optional: Google Gemini API key for multimodal PDF extraction (falls back to pdfplumber if unset)
GEMINI_API_KEY=

# Production PostgreSQL / Supabase connection string (falls back to local SQLite if unset)
# Example: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Optional: Comma-separated allowed CORS origins for production (defaults to * if unset)
# Example: https://your-app.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=
